{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "chicken_hat",
        "model": {
          "type": "minecraft:model",
          "model": "ax_free_hats_pack:chicken_hat"
        }
      },
      {
        "when": "diving_helmet",
        "model": {
          "type": "minecraft:model",
          "model": "ax_free_hats_pack:diving_helmet"
        }
      },
      {
        "when": "flight_hat",
        "model": {
          "type": "minecraft:model",
          "model": "ax_free_hats_pack:flight_hat"
        }
      },
      {
        "when": "military_helmet",
        "model": {
          "type": "minecraft:model",
          "model": "ax_free_hats_pack:military_helmet"
        }
      },
      {
        "when": "motorcycle_helmet",
        "model": {
          "type": "minecraft:model",
          "model": "ax_free_hats_pack:motorcycle_helmet"
        }
      },
      {
        "when": "pot_hat",
        "model": {
          "type": "minecraft:model",
          "model": "ax_free_hats_pack:pot_hat"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/leather_helmet"
    }
  }
}