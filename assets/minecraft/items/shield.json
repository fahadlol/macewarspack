{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "shield1",
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_true": {
            "type": "minecraft:model",
            "model": "ax_free_hats_pack:shield1_blocking"
          },
          "on_false": {
            "type": "minecraft:model",
            "model": "ax_free_hats_pack:shield1"
          }
        }
      },
      {
        "when": "gauntlet",
        "model": {
          "type": "minecraft:model",
          "model": "thanospack:gauntlet"
        }
      },
      {
        "when": "gauntlet_blocking",
        "model": {
          "type": "minecraft:model",
          "model": "thanospack:gauntlet_blocking"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:using_item",
      "on_true": {
        "type": "minecraft:special",
        "base": "minecraft:item/shield_blocking",
        "model": {
          "type": "minecraft:shield"
        }
      },
      "on_false": {
        "type": "minecraft:special",
        "base": "minecraft:item/shield",
        "model": {
          "type": "minecraft:shield"
        }
      }
    }
  }
}
